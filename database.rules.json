{
  "rules": {
    ".read": false,
    ".write": false,
    "userCouples": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('userCouples').child(auth.uid).exists() && root.child('userCouples').child(auth.uid).val() === root.child('userCouples').child($uid).val()))",
        ".write": "auth != null && auth.uid === $uid",
        "online": { ".validate": "newData.isBoolean()" },
        "typing": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "typingAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    }
  }
}
